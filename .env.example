# Copy this file to .env and fill in your key to enable LLM narration.
# The app works fully without this -- it falls back to a rule-based
# narrator -- so setting this up is optional, not required to run the demo.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if the frontend and backend run on different hosts/ports
# than the defaults (127.0.0.1:8000). Default is fine for local dev.
API_BASE_URL=http://127.0.0.1:8000
